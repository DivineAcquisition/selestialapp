# ---------------------------------------------------------------------------
# Selestial — Environment variables (example)
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# In production (Vercel / Cursor Cloud Agents), set these in the dashboard.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# SELESTIAL V2 — required
# ---------------------------------------------------------------------------

# Supabase.
# SUPABASE_SERVICE_ROLE_KEY is REQUIRED for v2: webhook intake, cron dispatch and
# provisioning write to tables that are intentionally unwritable under RLS, so the
# anon key is not a valid substitute there.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the app is served. Used in invites, webhook endpoint display and link generation.
NEXT_PUBLIC_APP_URL=https://app.selestial.io

# Host for tokenized outreach links. Keep it short: in SMS every character of domain is
# a character not spent on the message. Falls back to NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_LINK_BASE_URL=https://go.selestial.io

# Shared secret for the Vercel cron jobs. REQUIRED — without it /api/cron/* returns 503
# rather than running unauthenticated, because those endpoints send real messages.
CRON_SECRET=

# Messages sent per dispatch tick.
SELESTIAL_DISPATCH_BATCH=100

# Campaign email sending identity. One shared, agency-verified domain with a per-client
# from-name; see docs/email-sending for the DNS records.
SELESTIAL_SENDING_DOMAIN=mail.selestial.io
SELESTIAL_PLATFORM_FROM="Selestial <hello@selestial.io>"

# Resend webhook signing secret (whsec_...). When set, unsigned payloads are rejected.
RESEND_WEBHOOK_SECRET=

# Generation models. Sequences use the first, summaries and per-contact personalization
# the second.
SELESTIAL_GENERATION_MODEL=claude-sonnet-4-5-20250929
SELESTIAL_SUMMARY_MODEL=claude-3-5-haiku-20241022

# Default country code for phone normalization.
SELESTIAL_DEFAULT_COUNTRY_CODE=1

# Stripe
# - STRIPE_SECRET_KEY can be a full secret key (sk_live_...) OR a restricted
#   key (rk_live_...). If using a restricted key, it MUST have these scopes:
#     - customers: write
#     - subscriptions: write
#     - prices + products: read   (required to look up STRIPE_PRICE_ID below)
#     - payment_intents: read
# - STRIPE_PRICE_ID is the Stripe Price id for the $297/mo Selestial plan.
#   Pre-create the Product + recurring Price in the Stripe dashboard, then
#   paste the price id (price_...) here. Used by /api/onboarding/create-subscription.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Twilio (SMS speed-to-lead)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Resend (Email follow-up)
RESEND_API_KEY=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Meta (Facebook) Pixel — fired on /demo, /retarget, /offer, /offer/get-started
# Defaults to 350913587937360 if unset (the production pixel for access.selestial.io).
NEXT_PUBLIC_META_PIXEL_ID=350913587937360

# ---------------------------------------------------------------------------
# GoHighLevel (GHL) — Private Integration Token used during onboarding to sync
# contacts, opportunities, and SMS/email conversations from the customer's
# sub-account into Selestial speed-to-lead and re-engagement sequences.
#
# Create a PIT at:  Settings → Private Integrations → New Integration
# Token format:     pit-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
#
# A PIT authenticates fine with almost no scopes granted, and then 401s on every
# call that matters. Selestial needs all of these:
#   contacts.readonly + contacts.write
#   conversations.readonly + conversations/message.write
#   locations/customFields.readonly + .write
#   locations/tags.readonly + .write
#   locations.readonly + locations.write
# Verify with: Agency → Integrations → Capability check.
# ---------------------------------------------------------------------------
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
# Optional default location/sub-account to act on when not explicitly passed.
GHL_LOCATION_ID=
# Agency API key — required for sub-account (location) creation, listing, and
# deletion. Distinct from the per-location PIT above. Get it from your GHL
# Agency settings → API Keys. Treat as a secret; never expose to the client.
GHL_AGENCY_API_KEY=
# Optional: snapshot ID to install into every newly-created sub-account.
GHL_DEFAULT_SNAPSHOT_ID=
# Agency company id (the `company_id` claim inside the agency JWT). Required by v2 to
# mint per-location OAuth tokens.
GHL_AGENCY_COMPANY_ID=

# --- v2: agency OAuth (preferred over the keys above) ----------------------
# Create a marketplace app in your GHL agency, then connect it at
# /agency/integrations. The redirect URI must match exactly, protocol included.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_OAUTH_REDIRECT_URI=https://app.selestial.io/api/ghl/oauth/callback

# --- v2: inbound webhooks --------------------------------------------------
# GHL signs webhooks RSA-SHA256 over the raw body in `x-wh-signature`. Paste the
# public key from GHL's docs; `\n` escapes are handled.
GHL_WEBHOOK_PUBLIC_KEY=
# Reject any payload whose signature cannot be verified.
GHL_WEBHOOK_REQUIRE_SIGNATURE=false
# GHL v2 has no per-location webhook API — delivery is configured once on the
# marketplace app. Set true once it is subscribed, so the provisioning step can pass
# instead of reporting "action needed".
GHL_WEBHOOK_APP_CONFIGURED=false

# Our own ceiling on GHL calls per 10-second window, below their burst limit.
GHL_BURST_LIMIT=90
